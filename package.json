{
  "name": "and3rn3t-portfolio",
  "version": "2.0.0",
  "description": "Matthew Anderson's Portfolio Website",
  "type": "module",
  "homepage": "https://andernet.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/and3rn3t/and3rn3t"
  },
  "bugs": {
    "url": "https://github.com/and3rn3t/and3rn3t/issues"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "serve": "python3 -m http.server 8000",
    "build:wasm": "asc assembly/hero-sim.ts --config asconfig.json --target release && node -e \"const { rmSync } = require('node:fs'); rmSync('modules/wasm/hero-core.js', { force: true }); rmSync('modules/wasm/hero-core.d.ts', { force: true });\"",
    "build:wasm:debug": "asc assembly/hero-sim.ts --config asconfig.json --target debug",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy:worker": "wrangler deploy",
    "worker:dev": "wrangler dev worker/index.js",
    "generate:og": "node scripts/generate-og.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "generate:posts": "node scripts/generate-posts.mjs",
    "check:refs": "node scripts/check-refs.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\" --report-needless-disables",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm lint:css && pnpm format:check && pnpm test:unit && pnpm check:refs",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "6.5.1",
    "@playwright/test": "^1.60.0",
    "assemblyscript": "^0.28.19",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "keywords": [
    "portfolio",
    "github-pages",
    "es-modules",
    "cloudflare-workers",
    "vanilla-js"
  ],
  "author": "Matthew Anderson",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=11.8.0"
  }
}
