{
  "ignoreFiles": ["dist/**", "dist-worker/**", "node_modules/**"],
  "rules": {
    "declaration-property-value-disallowed-list": [
      {
        "/^(padding|margin|gap|row-gap|column-gap)(-.+)?$/": [
          "/^(?!.*\\b(clamp|max|min|env)\\().*\\d(px|rem|em)\\b/"
        ],
        "font-size": ["/^(?!.*\\b(clamp|max|min|env)\\().*\\d(px|rem|em)\\b/"],
        "letter-spacing": ["/^(?!.*\\b(clamp|max|min|env)\\().*\\d(px|rem|em)\\b/"],
        "line-height": ["/^-?\\d*\\.?\\d+$/"],
        "font-weight": ["/^\\d+$/"]
      },
      {
        "message": "Use a design-system token (var(--space-*), --font-size-*, --font-weight-*, --letter-spacing-*, --line-height-*). See CLAUDE.md > CSS Guidelines."
      }
    ]
  }
}
