# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
bower_components/

# Build outputs
dist/
dist-worker/
.wrangler/
build/
.tmp/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Wrangler local secrets/vars (e.g. ALLOW_UNVERIFIED_GUESTBOOK=1 for `pnpm worker:dev`)
.dev.vars
.dev.vars.*

# The Cloudflare API token for zone settings. Kept out of .dev.vars on purpose: wrangler
# loads that file into the local Worker's environment.
.cloudflare.env

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
/tmp/
*.tmp
*.temp

# Cache
.cache/
.parcel-cache/

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Testing files (debug/dev only)
/testing/
# Playwright test artifacts
test-results/
playwright-report/
